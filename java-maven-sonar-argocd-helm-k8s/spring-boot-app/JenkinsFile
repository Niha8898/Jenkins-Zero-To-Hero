
pipeline {
    agent {
        any
    }

    environment {
        AWS_REGION = 'eu-north-1'
        SONAR_URL = 'http://51.20.253.206:9000'
        DOCKER_IMAGE = 'niha8898/ultimate-cicd'
        APP_DIR = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app'
        MANIFEST_FILE = 'java-maven-sonar-argocd-helm-k8s/spring-boot-app-manifests/deployment.yml'
        GIT_REPO_NAME = 'Jenkins-Zero-To-Hero'
        GIT_USER_NAME = 'Niha8898'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
                sh 'ls -la'
            }
        }

        stage('Build and Test') {
            steps {
                dir("${APP_DIR}") {
                    sh 'mvn clean package'
                }
            }
        }

        stage('Static Code Analysis') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'sonarqube',
                        variable: 'SONAR_AUTH_TOKEN'
                    )
                ]) {
                    dir("${APP_DIR}") {
                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:3.10.0.2594:sonar \
                              -Dsonar.host.url="$SONAR_URL" \
                              -Dsonar.token="$SONAR_AUTH_TOKEN"
                        '''
                    }
                }
            }
        }

        stage('Build and Push Docker Image') {
            environment {
                IMAGE_TAG = "${BUILD_NUMBER}"
            }

            steps {
                script {
                    def imageName = "${DOCKER_IMAGE}:${IMAGE_TAG}"

                    dir("${APP_DIR}") {
                        sh "docker build -t ${imageName} ."
                    }

                    docker.withRegistry(
                        'https://index.docker.io/v1/',
                        'docker-cred'
                    ) {
                        docker.image(imageName).push()
                    }
                }
            }
        }

        stage('Update Deployment File') {
            steps {
                withCredentials([
                    string(
                        credentialsId: 'github',
                        variable: 'GITHUB_TOKEN'
                    )
                ]) {
                    sh '''
                        set -eu

                        git config user.email "niharikareddy5b5@gmail.com"
                        git config user.name "Niha8898"

                        sed -i "s/replaceImageTag/${BUILD_NUMBER}/g" \
                          "${MANIFEST_FILE}"

                        git add "${MANIFEST_FILE}"

                        if ! git diff --cached --quiet; then
                            git commit -m "Update deployment image to version ${BUILD_NUMBER}"

                            git -c \
                              "http.extraheader=AUTHORIZATION: basic $(printf 'x-access-token:%s' "$GITHUB_TOKEN" | base64 | tr -d '\\n')" \
                              push origin HEAD:main
                        else
                            echo "No manifest changes to commit."
                        fi
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully.'
        }

        failure {
            echo 'Pipeline failed. Check the stage logs above.'
        }

        always {
            echo 'Pipeline execution finished.'
        }
    }
}
